DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# SMSGate (https://sms-gate.app): copy these from the Android app,
# Home screen -> Cloud Server section, after tapping "Online".
SMSGATE_USERNAME=your-smsgate-username
SMSGATE_PASSWORD=your-smsgate-password
# Default is the public cloud server; only change it for a private/local server.
SMSGATE_BASE_URL=https://api.sms-gate.app/3rdparty/v1
